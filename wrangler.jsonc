{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "live-image",
    "main": "src/index.ts",
    "compatibility_date": "2026-02-05",
    "placement": { "mode": "smart" },
    "routes": [{ "pattern": "liveimage.adonix.org", "custom_domain": true }],
    "workers_dev": false,
    "preview_urls": false,
    "minify": true,
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "IMAGE_STORE",
                "class_name": "ImageStore",
            },
            {
                "name": "IMAGE_STREAM",
                "class_name": "ImageStream",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["ImageStore", "ImageStream"],
        },
    ],
}
